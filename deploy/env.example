# Droplet secrets file — fill in, then upload to the droplet as /etc/slack-bot/env (root, 0600):
#   scp env root@<droplet>:/etc/slack-bot/env && ssh root@<droplet> 'chmod 0600 /etc/slack-bot/env'
# Plain KEY=value, no quotes, no `export`. Lines starting with # are ignored.
# DATA_DIR and HEALTH_PORT are set by docker-compose.yml — do not add them here.

# --- Required ---------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
# GitHub PAT for gh (write access on repos where it should attach screenshots / open PRs)
GITHUB_TOKEN=
# `claude setup-token` output (sk-ant-oat…), valid ~1 year
ANTHROPIC_OAUTH_SETUP_TOKEN=

# --- Sizing (CPU-Optimized 4 vCPU / 8 GB) ------------------------------------
MAX_CONCURRENT_AGENTS=5
GRANTS_MAX_CONCURRENT_AGENTS=4
# AGENT_TIMEOUT_MS=900000

# --- Memory (git-backed; without it memory is local to the volume) ----------
MEMORY_REPO=dcl-regenesislabs/clawtonio-memory

# --- Optional ---------------------------------------------------------------
# MODEL=claude-sonnet-5
# LOG_CHANNEL_ID=C0123456789
# ALLOWED_TEAM_IDS=T0123456789
# SLACK_SOCKET_MAX_SILENCE_MS=150000

# Grants Agents (leave GRANTS_CHANNEL_ID empty to disable)
GRANTS_CHANNEL_ID=
GRANTS_AGENTS_REPO=dcl-regenesislabs/grants-evaluation-agents

# Discourse (all required together, or leave empty)
DISCOURSE_URL=
DISCOURSE_API_KEY=
DISCOURSE_CATEGORY_ID=
DISCOURSE_USER_SUBMITTER=dclgrants
DISCOURSE_USER_VOXEL=voxel
DISCOURSE_USER_CANVAS=canvas
DISCOURSE_USER_LOOP=loop
DISCOURSE_USER_SIGNAL=signal
DISCOURSE_USER_ORACLE=oracle

# PostHog (read-only personal key phx_…; leave empty to disable the skill)
POSTHOG_API_KEY=
# POSTHOG_PROJECTS=scenes:12345,explorer:67890
# POSTHOG_HOST=https://us.posthog.com

# Wearable validator (leave empty to disable the skill)
WEARABLE_VALIDATOR_TOKEN=
# WEARABLE_VALIDATOR_API=
