# Slack app credentials (Socket Mode)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Anthropic credentials — long-lived OAuth token from `claude setup-token` (valid ~1 year).
# This is itself the access token (sk-ant-oat…), used directly as the Bearer — not a refresh
# token. Seeds .auth.json on first run; no refresh exchange happens.
ANTHROPIC_OAUTH_SETUP_TOKEN=...

# Optional: override the default model (default: claude-sonnet-5)
# MODEL=claude-sonnet-5

# GitHub token (used by gh CLI)
GITHUB_TOKEN=ghp_...

# Optional: concurrency control for agent runs
MAX_CONCURRENT_AGENTS=3

# Optional: watchdog timeout per agent run in ms (default: 900000 = 15 min)
# A run that exceeds this is aborted and the error is posted to the thread
# AGENT_TIMEOUT_MS=900000

# Optional: Slack channel ID for audit logging bot requests
# LOG_CHANNEL_ID=C0123456789

# Optional: max ms the Socket Mode connection may stay down before the bot
# self-restarts via SIGTERM (default: 150000 = 150s). Needs a supervisor that
# restarts the process (docker restart, pm2, launchd).
# SLACK_SOCKET_MAX_SILENCE_MS=150000

# Optional: extra Slack workspace (team) IDs whose full members may use the bot,
# in addition to the bot's own workspace — e.g. the Decentraland team via Slack
# Connect. Comma-separated. Guests are always denied.
# ALLOWED_TEAM_IDS=T0123456789,T9876543210

# Optional: enable health check endpoint (GET /health/live)
# HEALTH_PORT=5000

# Optional: GitHub repo for persistent memory (e.g. owner/claw-memory)
# Cloned on startup, agent commits+pushes after each save
# Without this, memory uses a temp directory and is lost on restart
# MEMORY_REPO=dcl-regenesislabs/clawtonio-memory

# Grants Agents (optional — feature-flagged)
GRANTS_CHANNEL_ID=
GRANTS_AGENTS_REPO=dcl-regenesislabs/grants-evaluation-agents
GRANTS_MAX_CONCURRENT_AGENTS=4

# Grants Agents — Discourse forum integration (optional)
# Feature-flagged: without URL + API key + category + all 6 usernames,
# !post only marks locally approved.
# The admin API key must have "All Users" scope so it can impersonate each
# user via the Api-Username header. Posts are authored by:
#   submitter → creates the topic (e.g. "dclgrants")
#   voxel/canvas/loop/signal → post their respective agent evaluations
#   oracle → posts the final recommendation
# All 7 accounts must exist on the Discourse instance with write access
# to the configured category.
# DISCOURSE_URL=https://forum.example.org
# DISCOURSE_API_KEY=
# DISCOURSE_CATEGORY_ID=
# DISCOURSE_USER_SUBMITTER=dclgrants
# DISCOURSE_USER_VOXEL=voxel
# DISCOURSE_USER_CANVAS=canvas
# DISCOURSE_USER_LOOP=loop
# DISCOURSE_USER_SIGNAL=signal
# DISCOURSE_USER_ORACLE=oracle

# Poll auto-resolution — Phase 0: SHADOW MODE (optional, feature-flagged)
# When POLLS_CHANNEL_ID is set, the bot periodically finds Decentraland governance
# polls stuck in `Finished` (custom options the backend can't auto-resolve),
# classifies each outcome, and posts to this channel what it WOULD mark it as —
# WITHOUT taking any action. Used to validate the classifier before granting any
# write authority. See ~/Documents/poll-auto-resolution-plan.md.
# POLLS_CHANNEL_ID=C0123456789
# Optional overrides:
# GOVERNANCE_API_URL=https://governance.decentraland.org/api
# POLLS_INTERVAL_MS=600000            # how often to sweep for finished polls (default 10 min)
# POLLS_CONFIDENCE_THRESHOLD=0.85     # below this an LLM verdict is flagged "needs human review"
