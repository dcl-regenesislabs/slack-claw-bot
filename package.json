{
  "name": "slack-issue-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "DEBUG=true tsx watch src/index.ts",
    "cli": "tsx src/cli.ts",
    "build": "tsc --noEmit",
    "build:dist": "tsc",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@slack/bolt": "^5.0.0",
    "@tobilu/qmd": "^2.5.3",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
